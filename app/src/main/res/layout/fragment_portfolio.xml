<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    tools:context=".ui.portfolio.PortfolioFragment">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_16dp"
        android:paddingTop="@dimen/spacing_16dp"
        android:paddingBottom="@dimen/spacing_8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/portfolio_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_portfolio_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/portfolio_subtitle"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/text_secondary_dark" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_primary_dark" />
    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Content View -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Allocation Visual Charts Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_glowing"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/portfolio_summary_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/text_primary_dark"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="@dimen/spacing_12dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/current_allocation"
                                        android:textAppearance="?attr/textAppearanceLabelSmall"
                                        android:textColor="@color/text_secondary_dark" />

                                    <com.example.marketmind.ui.views.AllocationDonutChartView
                                        android:id="@+id/chart_current_allocation"
                                        android:layout_width="140dp"
                                        android:layout_height="140dp"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/suggested_allocation"
                                        android:textAppearance="?attr/textAppearanceLabelSmall"
                                        android:textColor="@color/accent_cyan"
                                        android:textStyle="bold" />

                                    <com.example.marketmind.ui.views.AllocationDonutChartView
                                        android:id="@+id/chart_suggested_allocation"
                                        android:layout_width="140dp"
                                        android:layout_height="140dp"
                                        android:layout_marginTop="4dp" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section D: Allocation Matrix Table -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_20dp"
                        android:layout_marginBottom="@dimen/spacing_8dp"
                        android:text="@string/allocation_comparison"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/text_primary_dark"
                        android:textStyle="bold" />

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_12dp"
                        android:paddingVertical="@dimen/spacing_4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="@string/col_asset"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/col_current"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/col_suggested"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary_dark" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/col_difference"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_secondary_dark" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_allocations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_allocation" />

                    <!-- Section E: Expandable Recommendation Rationale Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_rationale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16dp"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_dark"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <RelativeLayout
                                android:id="@+id/layout_rationale_header"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:text="@string/recommendation_explanation_title"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/iv_expand"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:contentDescription="@string/action_expand"
                                    app:srcCompat="@drawable/ic_expand_more"
                                    app:tint="@color/text_secondary_dark" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tv_rationale_body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/text_secondary_dark"
                                android:visibility="gone"
                                tools:text="Due to elevated market risk detected by LSTM and volatile regime classification by HMM, equity allocation is reduced by 20% to mitigate drawdown."
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Academic Disclaimer Line -->
                    <TextView
                        android:id="@+id/tv_disclaimer_compact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_24dp"
                        android:layout_marginBottom="@dimen/spacing_16dp"
                        android:gravity="center"
                        android:text="@string/settings_disclaimer_compact"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/text_secondary_dark" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Skeleton Container -->
            <include
                android:id="@+id/skeleton_view"
                layout="@layout/view_skeleton_portfolio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Error State Container -->
            <include
                android:id="@+id/error_view"
                layout="@layout/view_error_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State Container -->
            <include
                android:id="@+id/empty_view"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>