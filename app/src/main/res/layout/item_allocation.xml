<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_8dp"
    app:cardBackgroundColor="@color/surface_card_dark"
    app:cardCornerRadius="@dimen/chip_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_dark"
    app:strokeWidth="@dimen/stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_12dp">

        <View
            android:id="@+id/view_color_indicator"
            android:layout_width="10dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tv_asset_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12dp"
            android:layout_weight="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_primary_dark"
            android:textStyle="bold"
            tools:text="Large Cap Equity" />

        <TextView
            android:id="@+id/tv_current_pct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_secondary_dark"
            tools:text="50.0%" />

        <TextView
            android:id="@+id/tv_suggested_pct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/text_primary_dark"
            android:textStyle="bold"
            tools:text="40.0%" />

        <LinearLayout
            android:id="@+id/layout_diff_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_pill_negative"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/tv_difference_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/market_negative"
                android:textStyle="bold"
                tools:text="-10.0%" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>