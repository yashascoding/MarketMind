<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient_dark"
    android:orientation="vertical"
    tools:context=".ui.analytics.AnalyticsFragment">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_12dp"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:layout_marginBottom="@dimen/spacing_8dp"
        android:background="@drawable/bg_top_bar"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingTop="@dimen/spacing_12dp"
        android:paddingBottom="@dimen/spacing_12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/text_primary_dark"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/analytics_subtitle"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/text_secondary_dark" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_primary_dark" />
    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Content View -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Time Period Segmented Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_12dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_1m"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/period_1m" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_3m"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/period_3m" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_6m"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/period_6m" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_1y"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/period_1y" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/period_all" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_12dp"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_glowing"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/analytics_portfolio_return"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="@color/text_secondary_dark" />

                                <TextView
                                    android:id="@+id/tv_period_portfolio_return"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_4dp"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold"
                                    tools:text="+8.4%" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/analytics_benchmark_return"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="@color/text_secondary_dark" />

                                <TextView
                                    android:id="@+id/tv_period_benchmark_return"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_4dp"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold"
                                    tools:text="+6.1%" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/analytics_relative_return"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="@color/text_secondary_dark" />

                                <TextView
                                    android:id="@+id/tv_period_relative_return"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_4dp"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold"
                                    tools:text="+2.3%" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_12dp"
                        app:cardBackgroundColor="@color/surface_elevated_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_dark"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SMART INSIGHT"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/accent_cyan"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_analytics_insight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/text_primary_dark"
                                tools:text="Risk-adjusted performance is strong, with lower drawdown than the benchmark." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Performance Chart Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_glowing"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:text="@string/performance_chart_title"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chip_group_benchmark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_bench_nifty"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="NIFTY 50" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_bench_gold"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gold ETF" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_bench_bonds"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sovereign Bond" />
                            </com.google.android.material.chip.ChipGroup>

                            <com.example.marketmind.ui.views.PerformanceChartView
                                android:id="@+id/chart_performance"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/chart_height"
                                android:layout_marginTop="@dimen/spacing_12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Risk Metrics Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_20dp"
                        android:layout_marginBottom="@dimen/spacing_8dp"
                        android:text="@string/risk_metrics_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/text_primary_dark"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_risk_metrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_risk_metric" />

                    <!-- Historical Regime Timeline Section -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16dp"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_dark"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/regime_history_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/text_primary_dark"
                                android:textStyle="bold" />

                            <com.example.marketmind.ui.views.RegimeTimelineView
                                android:id="@+id/view_regime_timeline"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="@dimen/spacing_12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Error State Container -->
            <include
                android:id="@+id/error_view"
                layout="@layout/view_error_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State Container -->
            <include
                android:id="@+id/empty_view"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>