<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient_dark"
    android:orientation="vertical"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- Top App Bar with Glowing Status -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_12dp"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:layout_marginBottom="@dimen/spacing_8dp"
        android:background="@drawable/bg_top_bar"
        android:paddingHorizontal="@dimen/spacing_12dp"
        android:paddingTop="@dimen/spacing_12dp"
        android:paddingBottom="@dimen/spacing_12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="@dimen/spacing_4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_marketmind_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/text_primary_dark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8dp"
                    android:background="@drawable/bg_badge_neon"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="AI RADAR"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/text_secondary_dark"
                tools:text="As of 14:32 (Connected)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_connection_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_8dp"
                android:background="@drawable/bg_status_chip"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawablePadding="4dp"
                android:paddingHorizontal="@dimen/spacing_8dp"
                android:paddingVertical="@dimen/spacing_4dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/status_online"
                tools:text="Live Backend" />

            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_refresh"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_primary_dark" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary_dark" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Content View -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section B: Hero Market Risk Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_risk_gauge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_glowing"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/risk_gauge_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/text_primary_dark"
                                android:textStyle="bold" />

                            <com.example.marketmind.ui.views.RiskGaugeView
                                android:id="@+id/gauge_risk"
                                android:layout_width="@dimen/gauge_size"
                                android:layout_height="140dp"
                                android:layout_marginTop="@dimen/spacing_8dp" />

                            <TextView
                                android:id="@+id/tv_risk_explanation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8dp"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/text_secondary_dark"
                                tools:text="LSTM risk model detects elevated volatility probability." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section C: HMM Market Regime Detection Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_regime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16dp"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_dark"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/regime_title"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_regime_confidence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="@color/text_secondary_dark"
                                    tools:text="Confidence: 88%" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_regime_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="@null"
                                    app:srcCompat="@drawable/ic_shield_risk"
                                    app:tint="@color/risk_moderate" />

                                <TextView
                                    android:id="@+id/tv_regime_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_8dp"
                                    android:textAppearance="?attr/textAppearanceTitleLarge"
                                    android:textColor="@color/text_primary_dark"
                                    android:textStyle="bold"
                                    tools:text="Volatile Market" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_regime_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/text_secondary_dark"
                                tools:text="@string/regime_desc_volatile" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section D: Market Overview / Asset Watchlist -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_20dp"
                        android:layout_marginBottom="@dimen/spacing_8dp"
                        android:text="@string/market_overview_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/text_primary_dark"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_assets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_asset_card" />

                    <!-- Section E: Historical Risk Line Chart Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_historical_risk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_20dp"
                        app:cardBackgroundColor="@color/surface_card_dark"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_dark"
                        app:strokeWidth="@dimen/stroke_width">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/historical_risk_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/text_primary_dark"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chart_touch_hint"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/text_secondary_dark" />

                            <com.example.marketmind.ui.views.RiskLineChartView
                                android:id="@+id/chart_historical_risk"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/chart_height"
                                android:layout_marginTop="@dimen/spacing_12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Skeleton Container -->
            <include
                android:id="@+id/skeleton_view"
                layout="@layout/view_skeleton_dashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Error State Container -->
            <include
                android:id="@+id/error_view"
                layout="@layout/view_error_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State Container -->
            <include
                android:id="@+id/empty_view"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>